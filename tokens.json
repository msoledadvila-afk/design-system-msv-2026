{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design System unificado para María Soledad Vila — Portfolio (Vibe Coder) y Talento Impulsa Consulting (Institucional). Dos sub-marcas hermanas con estructura compartida y valores diferenciados.",
  "$metadata": {
    "version": "1.0.0",
    "lastUpdated": "2026-05-02",
    "author": "María Soledad Vila",
    "brands": ["portfolio", "talento-impulsa"]
  },

  "color": {
    "$description": "Paletas extraídas y sistematizadas de los materiales reales de cada sub-marca.",

    "portfolio": {
      "$description": "Vibe Coder & Arquitecta Digital. Paleta cálida, artesanal, humana.",
      "brand": {
        "primary":      { "$value": "#C4907C", "$type": "color", "$description": "Terracota — color de marca, CTAs primarios" },
        "primarySoft":  { "$value": "#D4A797", "$type": "color", "$description": "Terracota suavizado para gradientes y hover" },
        "primaryDeep":  { "$value": "#A87464", "$type": "color", "$description": "Terracota intenso para texto enfático y botones presionados" },
        "primaryGlow":  { "$value": "rgba(196,144,124,0.12)", "$type": "color", "$description": "Halo / glow / fondos de sección sutiles" },
        "primaryGlowStrong": { "$value": "rgba(196,144,124,0.22)", "$type": "color", "$description": "Halo más visible para destacados" }
      },
      "neutral": {
        "bg":         { "$value": "#F5F2F0", "$type": "color", "$description": "Fondo principal, beige cálido" },
        "bgAlt":      { "$value": "#EAE5E1", "$type": "color", "$description": "Fondo secundario / secciones alternadas" },
        "bgCard":     { "$value": "#FFFFFF", "$type": "color", "$description": "Fondo de tarjetas y elementos elevados" },
        "border":     { "$value": "#DDD7D2", "$type": "color", "$description": "Bordes definidos" },
        "borderLight":{ "$value": "#E8E3DF", "$type": "color", "$description": "Bordes sutiles" },
        "text":       { "$value": "#2C2A2E", "$type": "color", "$description": "Texto principal, casi negro con calidez" },
        "textDim":    { "$value": "#7A7580", "$type": "color", "$description": "Texto secundario, gris cálido" },
        "greyDark":   { "$value": "#4A464F", "$type": "color", "$description": "Gris oscuro para titulares" },
        "greyWarm":   { "$value": "#B5B0AB", "$type": "color", "$description": "Gris cálido para texto deshabilitado" }
      },
      "accent": {
        "$description": "Paleta extendida del PDF, para infografías, ilustraciones y secciones decorativas. Usar con moderación — no compiten con el terracota.",
        "sage":     { "$value": "#ABB7A3", "$type": "color", "$description": "Verde salvia — secciones de stats, fondos editoriales" },
        "lavender": { "$value": "#A48997", "$type": "color", "$description": "Lavanda apagado — círculos de stats, contraste suave" },
        "navy":     { "$value": "#1E2A47", "$type": "color", "$description": "Azul marino — números enfáticos, headers en bloques claros" },
        "sand":     { "$value": "#DAD2BB", "$type": "color", "$description": "Arena — fondos de sección editorial" }
      },
      "semantic": {
        "success": { "$value": "#7A9472", "$type": "color", "$description": "Verde cálido en línea con la paleta sage" },
        "warning": { "$value": "#D4A04A", "$type": "color", "$description": "Mostaza terroso, no amarillo brillante" },
        "danger":  { "$value": "#B5604A", "$type": "color", "$description": "Rojo terracota, no rojo puro" },
        "info":    { "$value": "#5A7090", "$type": "color", "$description": "Azul atemperado, en línea con navy" }
      }
    },

    "talento-impulsa": {
      "$description": "Consultora institucional. Paleta neutra cálida con acentos dorados y modo dark dramático para hero.",
      "brand": {
        "primary":     { "$value": "#9A7B3D", "$type": "color", "$description": "Dorado mostaza — color de marca, titulares decorativos" },
        "primarySoft": { "$value": "#B8995A", "$type": "color", "$description": "Dorado claro" },
        "primaryDeep": { "$value": "#75582A", "$type": "color", "$description": "Dorado oscuro / bronce para texto" }
      },
      "neutral": {
        "bgCream":    { "$value": "#EFE9DB", "$type": "color", "$description": "Crema cálido — fondo principal de slides" },
        "bgStone":    { "$value": "#DDD8D4", "$type": "color", "$description": "Piedra clara — fondos secundarios" },
        "bgWarm":     { "$value": "#E3D7D2", "$type": "color", "$description": "Beige rosado — bloques editoriales" },
        "bgCard":     { "$value": "#FFFFFF", "$type": "color", "$description": "Tarjetas elevadas" },
        "border":     { "$value": "#C8C0B5", "$type": "color", "$description": "Bordes" },
        "text":       { "$value": "#1A1814", "$type": "color", "$description": "Negro cálido institucional" },
        "textDim":    { "$value": "#6E6859", "$type": "color", "$description": "Texto secundario" }
      },
      "earth": {
        "$description": "Escala tierra usada en la torre de servicios. Sirve para jerarquizar 3 niveles (Profesional → Equipo → Institucional) o como sistema de tags.",
        "tier1": { "$value": "#E3D7D2", "$type": "color", "$description": "Crema rosado — Institucional / nivel premium" },
        "tier2": { "$value": "#BFABA2", "$type": "color", "$description": "Beige medio — Equipo" },
        "tier3": { "$value": "#8C7D7A", "$type": "color", "$description": "Marrón claro" },
        "tier4": { "$value": "#684B45", "$type": "color", "$description": "Cacao — Profesional / nivel base" },
        "tier5": { "$value": "#3B3935", "$type": "color", "$description": "Carbón — para contraste fuerte" }
      },
      "dark": {
        "$description": "Modo dark del hero institucional (portada PDF). Usar para portadas dramáticas, no para body.",
        "bg":      { "$value": "#0A0A0A", "$type": "color", "$description": "Negro profundo de fondo" },
        "surface": { "$value": "#1A1612", "$type": "color", "$description": "Superficies sobre el dark bg" },
        "teal":    { "$value": "#1F4A52", "$type": "color", "$description": "Verde petróleo — luz ambiente del hero" },
        "gold":    { "$value": "#D4B062", "$type": "color", "$description": "Dorado luminoso sobre dark" }
      },
      "semantic": {
        "success": { "$value": "#6B8E5A", "$type": "color" },
        "warning": { "$value": "#C4924A", "$type": "color" },
        "danger":  { "$value": "#A0524A", "$type": "color" },
        "info":    { "$value": "#4A6478", "$type": "color" }
      }
    }
  },

  "typography": {
    "$description": "Pares tipográficos diferenciados. Ambos cargan desde Google Fonts.",

    "portfolio": {
      "fontFamily": {
        "display": { "$value": "'Syne', sans-serif", "$type": "fontFamily", "$description": "Display geométrica con personalidad para titulares y números grandes" },
        "body":    { "$value": "'Outfit', sans-serif", "$type": "fontFamily", "$description": "Sans humanista limpia para body y UI" }
      },
      "fontWeight": {
        "light":     { "$value": 300, "$type": "fontWeight" },
        "regular":   { "$value": 400, "$type": "fontWeight" },
        "medium":    { "$value": 500, "$type": "fontWeight" },
        "semibold":  { "$value": 600, "$type": "fontWeight" },
        "bold":      { "$value": 700, "$type": "fontWeight" },
        "extrabold": { "$value": 800, "$type": "fontWeight" }
      },
      "googleFontsUrl": { "$value": "https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Syne:wght@400;600;700;800&display=swap", "$type": "string" }
    },

    "talento-impulsa": {
      "fontFamily": {
        "display":    { "$value": "'Outfit', sans-serif", "$type": "fontFamily", "$description": "Sans geométrica moderna para titulares institucionales" },
        "body":       { "$value": "'Outfit', sans-serif", "$type": "fontFamily", "$description": "Misma familia, distinto peso para mantener cohesión institucional" },
        "decorative": { "$value": "'Cormorant Garamond', serif", "$type": "fontFamily", "$description": "Serif itálica decorativa para citas, frases-tesis y firmas conceptuales" }
      },
      "fontWeight": {
        "light":     { "$value": 300, "$type": "fontWeight" },
        "regular":   { "$value": 400, "$type": "fontWeight" },
        "medium":    { "$value": 500, "$type": "fontWeight" },
        "semibold":  { "$value": 600, "$type": "fontWeight" },
        "bold":      { "$value": 700, "$type": "fontWeight" }
      },
      "googleFontsUrl": { "$value": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Outfit:wght@300;400;500;600;700&display=swap", "$type": "string" }
    },

    "scale": {
      "$description": "Escala tipográfica modular compartida (modular scale 1.250 — major third). Aplica a ambas marcas.",
      "xs":   { "$value": "0.75rem",  "$type": "dimension", "$description": "12px — captions, labels uppercase" },
      "sm":   { "$value": "0.875rem", "$type": "dimension", "$description": "14px — body small, microcopy" },
      "base": { "$value": "1rem",     "$type": "dimension", "$description": "16px — body default" },
      "md":   { "$value": "1.125rem", "$type": "dimension", "$description": "18px — body intro, lead" },
      "lg":   { "$value": "1.25rem",  "$type": "dimension", "$description": "20px — body grande" },
      "xl":   { "$value": "1.5rem",   "$type": "dimension", "$description": "24px — h4" },
      "2xl":  { "$value": "1.875rem", "$type": "dimension", "$description": "30px — h3" },
      "3xl":  { "$value": "2.25rem",  "$type": "dimension", "$description": "36px — h2" },
      "4xl":  { "$value": "3rem",     "$type": "dimension", "$description": "48px — h1" },
      "5xl":  { "$value": "3.75rem",  "$type": "dimension", "$description": "60px — display" },
      "6xl":  { "$value": "4.5rem",   "$type": "dimension", "$description": "72px — hero" }
    },

    "lineHeight": {
      "tight":   { "$value": 1.1,  "$type": "number", "$description": "Para titulares grandes" },
      "snug":    { "$value": 1.3,  "$type": "number" },
      "normal":  { "$value": 1.5,  "$type": "number" },
      "relaxed": { "$value": 1.65, "$type": "number", "$description": "Para body — mejora legibilidad en español" },
      "loose":   { "$value": 1.8,  "$type": "number" }
    },

    "letterSpacing": {
      "tighter": { "$value": "-0.04em", "$type": "string", "$description": "Headlines display grandes" },
      "tight":   { "$value": "-0.02em", "$type": "string" },
      "normal":  { "$value": "0",       "$type": "string" },
      "wide":    { "$value": "0.05em",  "$type": "string" },
      "widest":  { "$value": "0.18em",  "$type": "string", "$description": "Labels uppercase, mucha separación" }
    }
  },

  "spacing": {
    "$description": "Escala basada en múltiplos de 4px. Funciona igual en ambas marcas.",
    "0":  { "$value": "0",      "$type": "dimension" },
    "1":  { "$value": "0.25rem","$type": "dimension", "$description": "4px" },
    "2":  { "$value": "0.5rem", "$type": "dimension", "$description": "8px" },
    "3":  { "$value": "0.75rem","$type": "dimension", "$description": "12px" },
    "4":  { "$value": "1rem",   "$type": "dimension", "$description": "16px" },
    "5":  { "$value": "1.25rem","$type": "dimension", "$description": "20px" },
    "6":  { "$value": "1.5rem", "$type": "dimension", "$description": "24px" },
    "8":  { "$value": "2rem",   "$type": "dimension", "$description": "32px" },
    "10": { "$value": "2.5rem", "$type": "dimension", "$description": "40px" },
    "12": { "$value": "3rem",   "$type": "dimension", "$description": "48px" },
    "16": { "$value": "4rem",   "$type": "dimension", "$description": "64px" },
    "20": { "$value": "5rem",   "$type": "dimension", "$description": "80px" },
    "24": { "$value": "6rem",   "$type": "dimension", "$description": "96px — padding sección" },
    "32": { "$value": "8rem",   "$type": "dimension", "$description": "128px" }
  },

  "radius": {
    "$description": "Radios de borde. Portfolio usa 16px (orgánico cálido); Talento usa 4-8px (institucional).",
    "none": { "$value": "0",       "$type": "dimension" },
    "sm":   { "$value": "0.25rem", "$type": "dimension", "$description": "4px — institucional" },
    "md":   { "$value": "0.5rem",  "$type": "dimension", "$description": "8px — institucional cards" },
    "lg":   { "$value": "0.75rem", "$type": "dimension", "$description": "12px — botones inputs" },
    "xl":   { "$value": "1rem",    "$type": "dimension", "$description": "16px — DEFAULT portfolio (--radius)" },
    "2xl":  { "$value": "1.5rem",  "$type": "dimension", "$description": "24px — cards grandes portfolio" },
    "pill": { "$value": "9999px",  "$type": "dimension", "$description": "Pastillas, badges, CTAs orgánicos" }
  },

  "shadow": {
    "$description": "Sombras suaves. Las del portfolio usan tinte terracota; las institucionales son grises neutras.",
    "portfolio": {
      "sm": { "$value": "0 4px 16px rgba(196,144,124,0.12)", "$type": "shadow", "$description": "Hover sutil con tinte de marca" },
      "md": { "$value": "0 8px 24px rgba(196,144,124,0.12)", "$type": "shadow" },
      "lg": { "$value": "0 12px 32px rgba(196,144,124,0.15)", "$type": "shadow" },
      "xl": { "$value": "0 24px 48px rgba(196,144,124,0.18)", "$type": "shadow" }
    },
    "talento-impulsa": {
      "sm": { "$value": "0 2px 8px rgba(26,24,20,0.06)",  "$type": "shadow" },
      "md": { "$value": "0 8px 20px rgba(26,24,20,0.08)", "$type": "shadow" },
      "lg": { "$value": "0 16px 32px rgba(26,24,20,0.10)","$type": "shadow" },
      "xl": { "$value": "0 24px 48px rgba(26,24,20,0.14)","$type": "shadow" }
    }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "100ms", "$type": "duration" },
      "fast":    { "$value": "200ms", "$type": "duration" },
      "base":    { "$value": "300ms", "$type": "duration", "$description": "Default para hover y micro-interacciones" },
      "slow":    { "$value": "500ms", "$type": "duration" },
      "slower":  { "$value": "800ms", "$type": "duration", "$description": "Reveals en scroll, fade-up del hero" }
    },
    "easing": {
      "standard":  { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",   "$type": "cubicBezier" },
      "decelerate":{ "$value": "cubic-bezier(0, 0, 0.2, 1)",     "$type": "cubicBezier" },
      "accelerate":{ "$value": "cubic-bezier(0.4, 0, 1, 1)",     "$type": "cubicBezier" },
      "organic":   { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "Rebote sutil, sentido orgánico — para portfolio" }
    }
  },

  "breakpoint": {
    "sm":  { "$value": "640px",  "$type": "dimension" },
    "md":  { "$value": "768px",  "$type": "dimension", "$description": "Mobile→desktop nav switch" },
    "lg":  { "$value": "1024px", "$type": "dimension" },
    "xl":  { "$value": "1280px", "$type": "dimension" },
    "2xl": { "$value": "1536px", "$type": "dimension" }
  },

  "container": {
    "maxWidth": { "$value": "1100px", "$type": "dimension", "$description": "Ancho máximo de contenido — confirmado en código actual" }
  }
}
